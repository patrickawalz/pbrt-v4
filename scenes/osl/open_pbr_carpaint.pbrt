Integrator "path" "integer maxdepth" 6
LookAt 0 2.2 -5  0 0.6 0  0 1 0
Camera "perspective" "float fov" 30
Sampler "independent" "integer pixelsamples" 64 "integer seed" 1
Film "rgb" "integer xresolution" 240 "integer yresolution" 180 "string filename" "open_pbr_carpaint.exr"
WorldBegin
LightSource "infinite" "rgb L" [0.6 0.7 0.9]
AttributeBegin
  Translate 2 5 -3
  AreaLightSource "diffuse" "rgb L" [30 28 24]
  Shape "sphere" "float radius" 0.6
AttributeEnd
AttributeBegin
  Material "diffuse" "rgb reflectance" [0.4 0.4 0.4]
  Shape "trianglemesh" "point3 P" [-6 0 -6 6 0 -6 6 0 6 -6 0 6] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
  Translate 0 1 0
  Material "osl" "string shader" "open_pbr_carpaint.mtlx"
  Shape "sphere" "float radius" 1
AttributeEnd
