// A volume of marble: veins of a darker, more absorbing stone through a pale one that scatters nearly all of its light. The
// veins are those of pbrt's "marble" texture (a sine along y, displaced by fractal noise), in the space of the medium.
// The extinction is "density" everywhere (per unit length of the scene, after the scale of the medium), so "float majorant"
// may be given as that value.
#include "pbrt_volume.h"

volume marble_volume(float density = 60.0,
                     float scale = 5.0,
                     float variation = 2.2,
                     int octaves = 6,
                     float roughness = 0.5,
                     float sharpness = 3.0,
                     color stone = color(0.995, 0.99, 0.975),
                     color vein = color(0.55, 0.72, 0.90),
                     float g = 0.0)
{
    point Pm = transform("shader", P) * scale;
    float sum = 0.0, amplitude = 1.0, f = 1.0;
    for (int i = 0; i < octaves; ++i) {
        sum += amplitude * abs(noise("perlin", Pm * f));
        f *= 1.99;
        amplitude *= roughness;
    }
    float t = 0.5 + 0.5 * sin(Pm[1] + variation * sum);
    // (narrow veins: most of the stone is pale)
    t = pow(t, sharpness);
    color albedo = mix(stone, vein, t);
    Ci = absorption() * (density * (color(1.0) - albedo)) + henyey_greenstein(g) * (density * albedo);
}
