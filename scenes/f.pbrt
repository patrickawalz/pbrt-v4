LookAt 0 0 -6  0 0 0  0 1 0
Camera "perspective" "float fov" 30
Sampler "independent" "integer pixelsamples" 64
Integrator "volpath" "integer maxdepth" 100
Film "rgb" "integer xresolution" 40 "integer yresolution" 30 "string filename" "f.png"
MakeNamedMedium "fog" "string type" "homogeneous" "rgb sigma_a" [0 0 0] "rgb sigma_s" [1 1 1]
WorldBegin
LightSource "infinite" "rgb L" [0.5 0.5 0.5]
AttributeBegin
  MediumInterface "fog" ""
  Material "interface"
  Shape "sphere" "float radius" 2.5
AttributeEnd
