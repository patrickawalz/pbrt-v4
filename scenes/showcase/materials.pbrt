# Materials: one sphere each of the materials that pbrt-v4 does not have (see docs/: pearlescent.md, glint.md, sponge-cake.md,
# bragg-mirrors.md), on a diffuse floor.
LookAt 0 5.5 -10  0 0.6 0.2  0 1 0
Camera "perspective" "float fov" 34
Sampler "independent" "integer pixelsamples" 128 "integer seed" 7
Integrator "volpath" "integer maxdepth" 12
Film "rgb" "integer xresolution" 800 "integer yresolution" 450 "string filename" "materials.exr"
WorldBegin
LightSource "infinite" "rgb L" [0.5 0.55 0.65]
LightSource "distant" "point3 from" [-3 6 -4] "point3 to" [0 0 0] "rgb L" [3.2 3 2.7]
AttributeBegin
  Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
  Shape "trianglemesh" "integer indices" [0 2 1 0 3 2] "point3 P" [-30 0 -30  30 0 -30  30 0 30  -30 0 30]
AttributeEnd
# Front row
AttributeBegin
  Translate -3.3 0.8 -1
  Material "pearlescent"
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate -1.1 0.8 -1
  Material "multiscatterconductor"
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate 1.1 0.8 -1
  Material "spongecake" "string layers" [ "fiber" "surface" ] "float roughness" [ 0.1 0.8 ] "float thickness" [ 1 5 ]
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate 3.3 0.8 -1
  Material "bragg" "float layereta" [ 1 1.5 ] "float layerthickness" [ 125 375 ] "integer layerrepeat" 20
  Shape "sphere" "float radius" 0.8
AttributeEnd
# Back row
AttributeBegin
  Translate -3.3 0.8 1.4
  Material "thinfilm" "float layereta" [ 1.5 1 ] "float layerthickness" [ 92 138 ] "integer layerrepeat" 20
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate -1.1 0.8 1.4
  Material "hazygloss"
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate 1.1 0.8 1.4
  Material "sggxsheen"
  Shape "sphere" "float radius" 0.8
AttributeEnd
AttributeBegin
  Translate 3.3 0.8 1.4
  Material "coatedconductor"
  Shape "sphere" "float radius" 0.8
AttributeEnd
