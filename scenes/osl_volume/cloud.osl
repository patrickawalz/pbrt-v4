// A procedural cloud: fractal noise inside a sphere, thresholded to a density. Works in the medium space of MakeNamedMedium (the CTM there),
// the unit cube by default ("point3 p0/p1"). The density is at most "density" (per unit length of medium space), so give
// "float majorant" density * 1.0 to the medium when the majorant should not be estimated from samples of the shader.
#include "pbrt_volume.h"

volume cloud(float density = 8.0,
             float frequency = 3.0,
             int octaves = 5,
             float lacunarity = 2.0,
             float gain = 0.5,
             float coverage = 0.5,
             float softness = 0.25,
             color albedo = color(0.96, 0.97, 1.0),
             float g = 0.35,
             point center = point(0.5, 0.5, 0.5),
             float radius = 0.5,
             float offset = 0.0)
{
    point Pm = transform("shader", P);
    float r = distance(Pm, center) / radius;
    float envelope = 1.0 - smoothstep(0.55, 1.0, r);
    float n = 0.0, amplitude = 0.5, f = frequency, norm = 0.0;
    point q = Pm + vector(offset, 0, 0);
    for (int i = 0; i < octaves; ++i) {
        n += amplitude * noise(q * f);
        norm += amplitude;
        f *= lacunarity;
        amplitude *= gain;
    }
    n /= norm;
    float shape = smoothstep(1.0 - coverage - softness, 1.0 - coverage + softness, n * envelope + 0.5 * envelope * envelope - 0.15);
    float sigma_t = density * shape;
    Ci = absorption() * (sigma_t * (1.0 - albedo)) + henyey_greenstein(g) * (sigma_t * albedo);
}
