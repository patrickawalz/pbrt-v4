# Cornell box through the 50 mm double Gauss lens, wide open and without coatings: the ghosts of the bulb, the veiling
# glare, the vignetting and the discs of the lights out of focus
LookAt 0 0.275 -1.45  0 0.275 0  0 1 0
Camera "realistic2" "string lensfile" "dgauss.50mm.dat" "float focusdistance" 1.4
    "float aperturediameter" 17.1
    "bool ghosts" true "float sensorreflectance" 0.03
    "float dirt" 0.02 "float dirtg" 0.9 "float barrelalbedo" 0.04
Sampler "independent" "integer pixelsamples" 256 "integer seed" 1
Integrator "jrlt" "string pathestimator" "bdpt" "integer maxdepth" 8 "integer mutationsperpixel" 512
Film "rgb" "integer xresolution" 512 "integer yresolution" 512 "float iso" 100 "string filename" "cornell_flare_wide-jrlt-bdpt.exr"
WorldBegin
Include "cornell_flare_world.pbrt"
