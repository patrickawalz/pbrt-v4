# Cornell box through the 50 mm double Gauss lens, wide open, with none of the stray light: what camera "realistic" gives
LookAt 0 0.275 -1.45  0 0.275 0  0 1 0
Camera "realistic2" "string lensfile" "dgauss.50mm.dat" "float focusdistance" 1.4
    "float aperturediameter" 17.1
Sampler "independent" "integer pixelsamples" 256 "integer seed" 1
Integrator "mlt" "string pathestimator" "volpath" "integer maxdepth" 8 "integer mutationsperpixel" 512
Film "rgb" "integer xresolution" 512 "integer yresolution" 512 "float iso" 100 "string filename" "cornell_flare_plain-mlt-volpath.exr"
WorldBegin
Include "cornell_flare_world.pbrt"
