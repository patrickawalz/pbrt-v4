# A block of a homogeneous medium of SGGX microflakes on a floor, lit from the upper left. Only the "microflakes"
# parameters differ between the sggx_*.pbrt scenes.
MakeNamedMedium "flakes" "string type" "homogeneous" "rgb sigma_a" [0.15 0.4 1.2] "rgb sigma_s" [6 6 6] "string microflakes" "fibre" "vector3 flakeaxis" [0 0 1] "float flakeroughness" 0.2
LookAt 0 -6 2.6  0 0 0.8  0 0 1
Camera "perspective" "float fov" 36
Sampler "independent" "integer pixelsamples" 256 "integer seed" 4
Integrator "volpath" "integer maxdepth" 40
Film "rgb" "integer xresolution" 360 "integer yresolution" 270 "string filename" "sggx_fibre_z.exr"
WorldBegin
LightSource "distant" "point3 from" [-4 -2 5] "point3 to" [0 0 0] "rgb L" [5 5 5]
LightSource "infinite" "rgb L" [0.25 0.3 0.4]
AttributeBegin
Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
Shape "trianglemesh" "point3 P" [-20 -20 0  20 -20 0  20 20 0  -20 20 0] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
MediumInterface "flakes" ""
Material "interface"
Translate 0 0 0.9
Rotate 25 0 0 1
Shape "trianglemesh" "point3 P" [-1 -1 -0.9  1 -1 -0.9  1 1 -0.9  -1 1 -0.9  -1 -1 0.9  1 -1 0.9  1 1 0.9  -1 1 0.9]
    "integer indices" [0 2 1 0 3 2  4 5 6 4 6 7  0 1 5 0 5 4  2 3 7 2 7 6  0 4 7 0 7 3  1 2 6 1 6 5]
AttributeEnd
