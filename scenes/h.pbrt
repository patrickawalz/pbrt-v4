LookAt 0 0 -6  0 0 0  0 1 0
Camera "perspective" "float fov" 0.2
Sampler "independent" "integer pixelsamples" 100000
Integrator "volpath" "integer maxdepth" 1
Film "rgb" "integer xresolution" 3 "integer yresolution" 3 "string filename" "h.pfm"
MakeNamedMedium "fog" "string type" "homogeneous" "rgb sigma_a" [0.1 0.1 0.1] "rgb sigma_s" [0.5 0.5 0.5]
WorldBegin
LightSource "point" "rgb I" [20 20 20] "point3 from" [0 1 0]
AttributeBegin
  MediumInterface "fog" ""
  Material "interface"
  Shape "sphere" "float radius" 2.5
AttributeEnd
