<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>opensubdiv_lib</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <RootNamespace>OpenSubdiv</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0108;CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ext/opensubdiv/sdc/*.cs;../ext/opensubdiv/vtr/*.cs;../ext/opensubdiv/far/*.cs" />
  </ItemGroup>
</Project>
