<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>pbrt_lib</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RootNamespace>pbrt</RootNamespace>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ext/**/*.cs" Exclude="../ext/gtest/**;../ext/opensubdiv/sdc/**;../ext/opensubdiv/vtr/**;../ext/opensubdiv/far/**;../ext/opensubdiv/tests/**;../ext/ptex/src/utils/**;../ext/ptex/src/tests/**;../ext/**/*_test.cs" />
    <Compile Remove="cmd/**;rgbspec/**;**/*_test.cs;bin/**;obj/**" />
  </ItemGroup>
  <!-- The RGB-to-spectrum tables are an assembly of their own, pbrt_rgbspec. By default (a clone of the repository, the CI build) it is
       rgbspec/source: rgb2spec_opt writes the tables as source with array initializers and they are compiled. A machine whose compiler
       runs out of memory on that sets RgbSpecProject in local.props (not in git) to rgbspec/external: the values are written as .bin files
       that are copied beside the programs and loaded at startup. -->
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
  <PropertyGroup>
    <RgbSpecProject Condition="'$(RgbSpecProject)' == ''">rgbspec/source/pbrt_rgbspec.csproj</RgbSpecProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../opensubdiv_lib/opensubdiv_lib.csproj" />
    <ProjectReference Include="$(RgbSpecProject)" />
    <ProjectReference Include="../osl/osl_lib.csproj" />
  </ItemGroup>
</Project>
