<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>pbrt_lib</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RootNamespace>pbrt</RootNamespace>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ext/**/*.cs" Exclude="../ext/gtest/**;../ext/opensubdiv/sdc/**;../ext/opensubdiv/vtr/**;../ext/opensubdiv/far/**;../ext/opensubdiv/tests/**;../ext/ptex/src/utils/**;../ext/ptex/src/tests/**;../ext/**/*_test.cs" />
    <Compile Remove="cmd/**;rgbspec/**;**/*_test.cs;bin/**;obj/**" />
  </ItemGroup>
  <!-- The RGB-to-spectrum tables are generated at build time by rgb2spec_opt, as the pbrt-v4 CMake build does: a small rgbspectrum_*.cs
       for each color space and a binary file of the coefficients (9 MB each). By default (a clone of the repository, the CI build) the
       binary files are embedded in this assembly. A machine whose compiler cannot embed them (a small one: the build runs out of memory)
       sets RgbSpecExternal to true in local.props (not in git): the files are then written next to the assembly and loaded from there
       when the program starts, and nothing large goes through the compiler. -->
  <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')" />
  <ItemGroup>
    <ProjectReference Include="../opensubdiv_lib/opensubdiv_lib.csproj" />
    <ProjectReference Include="cmd/rgb2spec_opt.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;UseAppHost" />
  </ItemGroup>

  <PropertyGroup>
    <RgbSpecDir>$(MSBuildThisFileDirectory)obj/rgbspec/</RgbSpecDir>
    <RgbSpecTool>$(MSBuildThisFileDirectory)cmd/bin/$(Configuration)/net10.0/rgb2spec_opt.dll</RgbSpecTool>
  </PropertyGroup>

  <Target Name="GenerateRgbSpectrumTables" BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile"
          Inputs="$(MSBuildThisFileDirectory)cmd/rgb2spec_opt.cs;$(RgbSpecTool)"
          Outputs="$(RgbSpecDir)rgbspectrum_srgb.bin;$(RgbSpecDir)rgbspectrum_srgb.cs;$(RgbSpecDir)rgbspectrum_dci_p3.cs;$(RgbSpecDir)rgbspectrum_rec2020.cs;$(RgbSpecDir)rgbspectrum_aces.cs">
    <MakeDir Directories="$(RgbSpecDir)" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_srgb.cs&quot; sRGB" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_dci_p3.cs&quot; DCI_P3" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_rec2020.cs&quot; REC2020" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_aces.cs&quot; ACES2065_1" />
  </Target>

  <Target Name="AddRgbSpectrumTables" BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile" DependsOnTargets="GenerateRgbSpectrumTables">
    <ItemGroup>
      <Compile Include="$(RgbSpecDir)rgbspectrum_*.cs" />
      <RgbSpecBinary Include="$(RgbSpecDir)rgbspectrum_*.bin" />
      <EmbeddedResource Include="@(RgbSpecBinary)" LogicalName="%(RgbSpecBinary.Filename).bin" Condition="'$(RgbSpecExternal)' != 'true'" />
      <Content Include="@(RgbSpecBinary)" Link="%(RgbSpecBinary.Filename).bin" CopyToOutputDirectory="PreserveNewest" Condition="'$(RgbSpecExternal)' == 'true'" />
    </ItemGroup>
  </Target>
</Project>
