<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>pbrt_lib</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RootNamespace>pbrt</RootNamespace>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ext/**/*.cs" Exclude="../ext/gtest/**;../ext/opensubdiv/sdc/**;../ext/opensubdiv/vtr/**;../ext/opensubdiv/far/**;../ext/opensubdiv/tests/**;../ext/ptex/src/utils/**;../ext/ptex/src/tests/**;../ext/**/*_test.cs" />
    <Compile Remove="cmd/**;rgbspec/**;**/*_test.cs;bin/**;obj/**" />
  </ItemGroup>
  <!-- The RGB-to-spectrum tables (generated at build time by rgb2spec_opt, as the pbrt-v4 CMake build does) are an assembly of their own
       (rgbspec/pbrt_rgbspec.csproj): about 150 MB of source that the compiler cannot hold together with this library on a small machine. -->
  <ItemGroup>
    <ProjectReference Include="../opensubdiv_lib/opensubdiv_lib.csproj" />
    <ProjectReference Include="rgbspec/pbrt_rgbspec.csproj" />
  </ItemGroup>
</Project>
