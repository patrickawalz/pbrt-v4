<Project Sdk="Microsoft.NET.Sdk">
  <!-- The RGB-to-spectrum tables for a machine whose compiler cannot hold the array initializers of ../source: rgb2spec_opt (with its "bin"
       argument) writes a small rgbspectrum_*.cs and a .bin file of the values for each table; the .bin files are copied beside the assembly
       (and, through the project references, beside every program that uses it) and RgbSpectrumResources loads them at startup. Same
       assembly name and the same classes as ../source, so pbrt_lib does not change. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>pbrt_rgbspec</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>pbrt</RootNamespace>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981;CS0660;CS0661</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="rgbspectrumresources.cs" />
    <ProjectReference Include="../../cmd/rgb2spec_opt.csproj" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile;UseAppHost" />
  </ItemGroup>

  <PropertyGroup>
    <RgbSpecDir>$(MSBuildThisFileDirectory)obj/rgbspec/</RgbSpecDir>
    <RgbSpecTool>$(MSBuildThisFileDirectory)../../cmd/bin/$(Configuration)/net10.0/rgb2spec_opt.dll</RgbSpecTool>
  </PropertyGroup>

  <Target Name="GenerateRgbSpectrumTables" BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile"
          Inputs="$(MSBuildThisFileDirectory)../../cmd/rgb2spec_opt.cs;$(RgbSpecTool)"
          Outputs="$(RgbSpecDir)rgbspectrum_srgb.bin;$(RgbSpecDir)rgbspectrum_srgb.cs;$(RgbSpecDir)rgbspectrum_dci_p3.cs;$(RgbSpecDir)rgbspectrum_rec2020.cs;$(RgbSpecDir)rgbspectrum_aces.cs">
    <MakeDir Directories="$(RgbSpecDir)" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_srgb.cs&quot; sRGB bin" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_dci_p3.cs&quot; DCI_P3 bin" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_rec2020.cs&quot; REC2020 bin" />
    <Exec Command="dotnet &quot;$(RgbSpecTool)&quot; 64 &quot;$(RgbSpecDir)rgbspectrum_aces.cs&quot; ACES2065_1 bin" />
  </Target>

  <Target Name="AddRgbSpectrumTables" BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile" DependsOnTargets="GenerateRgbSpectrumTables">
    <ItemGroup>
      <Compile Include="$(RgbSpecDir)rgbspectrum_*.cs" />
      <RgbSpecBinary Include="$(RgbSpecDir)rgbspectrum_*.bin" />
      <Content Include="@(RgbSpecBinary)" Link="%(RgbSpecBinary.Filename).bin" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
