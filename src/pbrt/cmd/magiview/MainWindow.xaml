<Window x:Class="magiview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magi" Width="1280" Height="820" Background="#202020" Closing="OnClosing">
    <DockPanel>
        <!-- The render: what to render, when to stop, and the buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <Button x:Name="openButton" Content="Open scene..." Padding="10,3" Click="OnOpen"/>
            <TextBlock Text="halt spp" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <TextBox x:Name="haltSppBox" Width="60" Text="0" VerticalContentAlignment="Center"/>
            <TextBlock Text="halt time (s)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="haltTimeBox" Width="60" Text="0" VerticalContentAlignment="Center"/>
            <TextBlock Text="update (s)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="intervalBox" Width="50" Text="0.5" VerticalContentAlignment="Center"/>
            <Button x:Name="startButton" Content="Start" Padding="12,3" Margin="14,0,0,0" IsEnabled="False" Click="OnStart"/>
            <Button x:Name="pauseButton" Content="Pause" Padding="12,3" Margin="6,0,0,0" IsEnabled="False" Click="OnPause"/>
            <Button x:Name="stopButton" Content="Stop" Padding="12,3" Margin="6,0,0,0" IsEnabled="False" Click="OnStop"/>
            <TextBlock Text="threads" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <Button x:Name="fewerButton" Content="-" Width="26" IsEnabled="False" Click="OnFewerThreads"/>
            <TextBlock x:Name="threadsText" Text="0" Foreground="#ffffff" VerticalAlignment="Center" Width="30" TextAlignment="Center"/>
            <Button x:Name="moreButton" Content="+" Width="26" IsEnabled="False" Click="OnMoreThreads"/>
            <TextBlock Text="exposure (EV)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <Slider x:Name="exposureSlider" Width="130" Minimum="-6" Maximum="6" Value="0" VerticalAlignment="Center" ValueChanged="OnExposure"/>
            <Button x:Name="saveButton" Content="Save image..." Padding="10,3" Margin="14,0,0,0" IsEnabled="False" Click="OnSave"/>
        </StackPanel>
        <TextBlock x:Name="statusText" DockPanel.Dock="Bottom" Foreground="#d0d0d0" Margin="8,4" Text="No scene."/>
        <!-- The light layers: one row each, made when the scene's layers are known -->
        <ScrollViewer DockPanel.Dock="Right" Width="330" VerticalScrollBarVisibility="Auto" Background="#2a2a2a">
            <StackPanel x:Name="layersPanel" Margin="8">
                <TextBlock Text="Light layers" Foreground="#ffffff" FontWeight="Bold" Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="filmImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </ScrollViewer>
    </DockPanel>
</Window>
