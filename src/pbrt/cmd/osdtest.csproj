<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osdtest</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>OpenSubdiv</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0162;CS0164;CS0168;CS0219;CS0649;CS0169;CS0414;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ext/opensubdiv/tests/osdtest.cs" />
    <ProjectReference Include="../../opensubdiv_lib/opensubdiv_lib.csproj" />
  </ItemGroup>
</Project>
