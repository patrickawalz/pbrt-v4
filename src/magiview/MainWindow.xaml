<Window x:Class="magiview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:magiview"
        Title="Magi" Width="1280" Height="820" Background="#202020" Closing="OnClosing" PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>
        <!-- The render: what to render, when to stop, and the buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
            <Button x:Name="openButton" Content="Open scene..." Padding="10,3" Click="OnOpen"/>
            <TextBlock Text="halt spp" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <TextBox x:Name="haltSppBox" Width="60" Text="0" VerticalContentAlignment="Center"/>
            <TextBlock Text="halt time (s)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="haltTimeBox" Width="60" Text="0" VerticalContentAlignment="Center"/>
            <TextBlock Text="update (s)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="intervalBox" Width="50" Text="0.5" VerticalContentAlignment="Center"/>
            <Button x:Name="startButton" Content="Start" Padding="12,3" Margin="14,0,0,0" IsEnabled="False" Click="OnStart"/>
            <Button x:Name="pauseButton" Content="Pause" Padding="12,3" Margin="6,0,0,0" IsEnabled="False" Click="OnPause"/>
            <Button x:Name="stopButton" Content="Stop" Padding="12,3" Margin="6,0,0,0" IsEnabled="False" Click="OnStop"/>
            <TextBlock Text="threads" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <Button x:Name="fewerButton" Content="-" Width="26" IsEnabled="False" Click="OnFewerThreads"/>
            <TextBlock x:Name="threadsText" Text="0" Foreground="#ffffff" VerticalAlignment="Center" Width="30" TextAlignment="Center"/>
            <Button x:Name="moreButton" Content="+" Width="26" IsEnabled="False" Click="OnMoreThreads"/>
            <TextBlock Text="exposure (EV)" Foreground="#d0d0d0" VerticalAlignment="Center" Margin="14,0,4,0"/>
            <Slider x:Name="exposureSlider" Width="130" Minimum="-6" Maximum="6" Value="0" VerticalAlignment="Center" ValueChanged="OnExposure"/>
            <Button x:Name="saveButton" Content="Save image..." Padding="10,3" Margin="14,0,0,0" IsEnabled="False" Click="OnSave"/>
        </StackPanel>
        <!-- The zoom (as the image window of Photoshop has it at the lower left) and the state of the render -->
        <DockPanel DockPanel.Dock="Bottom" Margin="6,4">
            <ComboBox x:Name="zoomBox" DockPanel.Dock="Left" Width="90" IsEditable="True" IsReadOnly="True" SelectionChanged="OnZoomChosen"/>
            <Button DockPanel.Dock="Left" Content="-" Width="26" Margin="6,0,0,0" ToolTip="Zoom out (Ctrl -)" Click="OnZoomOut"/>
            <Button DockPanel.Dock="Left" Content="+" Width="26" Margin="2,0,0,0" ToolTip="Zoom in (Ctrl +)" Click="OnZoomIn"/>
            <Button DockPanel.Dock="Left" Content="Fit" Padding="8,1" Margin="6,0,0,0" ToolTip="Fit on screen (Ctrl 0)" Click="OnZoomFit"/>
            <Button DockPanel.Dock="Left" Content="100%" Padding="8,1" Margin="2,0,0,0" ToolTip="Actual pixels (Ctrl 1)" Click="OnZoomActual"/>
            <!-- What the left button does on the film -->
            <RadioButton x:Name="moveModeButton" DockPanel.Dock="Left" GroupName="zoomMode" Content="Hand" IsChecked="True" Foreground="#d0d0d0" Margin="12,0,0,0"
                         VerticalAlignment="Center" ToolTip="Drag to pan, double click to fit (H)" Checked="OnZoomMode"/>
            <RadioButton x:Name="zoomModeButton" DockPanel.Dock="Left" GroupName="zoomMode" Content="Zoom" Foreground="#d0d0d0" Margin="8,0,0,0"
                         VerticalAlignment="Center" ToolTip="Click to zoom in, Alt click to zoom out (Z)" Checked="OnZoomMode"/>
            <RadioButton x:Name="marqueeModeButton" DockPanel.Dock="Left" GroupName="zoomMode" Content="Marquee" Foreground="#d0d0d0" Margin="8,0,0,0"
                         VerticalAlignment="Center" ToolTip="Drag a rectangle to zoom to it (M)" Checked="OnZoomMode"/>
            <TextBlock x:Name="statusText" Foreground="#d0d0d0" Margin="12,0,0,0" VerticalAlignment="Center" Text="No scene."/>
        </DockPanel>
        <!-- The light layers: one row each, made when the scene's layers are known -->
        <ScrollViewer DockPanel.Dock="Right" Width="330" VerticalScrollBarVisibility="Auto" Background="#2a2a2a">
            <StackPanel x:Name="layersPanel" Margin="8">
                <TextBlock Text="Light layers" Foreground="#ffffff" FontWeight="Bold" Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>
        <!-- The film: the wheel zooms about the cursor, a drag pans, a double click fits (ZoomPanel.cs) -->
        <local:ZoomPanel x:Name="zoomPanel" Background="#202020">
            <Image x:Name="filmImage" Stretch="None"/>
        </local:ZoomPanel>
    </DockPanel>
</Window>
