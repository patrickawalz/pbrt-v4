<Project Sdk="Microsoft.NET.Sdk">
  <!-- (not in pbrt-v4) magiview: a window that shows a render as it goes, for the progressive renderer. Windows only (WPF);
       EnableWindowsTargeting lets it be compiled, though not run, on other systems. It is not part of the default build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>magiview</AssemblyName>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <!-- (not InvariantGlobalization, which the programs of cmd have: a WPF text box asks for the culture of the keyboard when it
         takes the focus, and there is none but the invariant one in that mode. The window sets the invariant culture for the
         threads instead, for the numbers that the renderer reads and writes.) -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>magiview</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../pbrt/pbrt_lib.csproj" />
    <ProjectReference Include="../controls/controls.csproj" />
  </ItemGroup>
</Project>
