<Project Sdk="Microsoft.NET.Sdk">
  <!-- (not in pbrt-v4) magiview: a window that shows a render as it goes, for the progressive renderer. Windows only (WPF);
       EnableWindowsTargeting lets it be compiled, though not run, on other systems. It is not part of the default build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>magiview</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>magiview</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../pbrt/pbrt_lib.csproj" />
  </ItemGroup>
</Project>
